<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<!-- v4 (AngularJS) targets Umbraco 8-13; v5 (Lit) targets Umbraco 16+ -->
		<TargetFrameworks Condition="'$(Version)' &lt; '5.0.0'">net472;net5.0;net6.0;net7.0;net8.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(Version)' &gt;= '5.0.0'">net9.0;net10.0</TargetFrameworks>
		<RootNamespace>Our.Umbraco.SimpleTreeMenu</RootNamespace>

		<AssemblyName>Our.Umbraco.SimpleTreeMenu</AssemblyName>
		<Authors>Dennis Öhman, David Sandström</Authors>
		<Company>Björnmamman AB Sweden</Company>

		<Description>Typed Treemenu for Umbraco</Description>
		<PackageIcon>icon.png</PackageIcon>
		<PackageId>Our.Umbraco.SimpleTreeMenu</PackageId>
		<Version>5.0.0</Version>
		<PackageProjectUrl>https://github.com/Bjornmamman/Our.Umbraco.SimpleTreeMenu</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Bjornmamman/Our.Umbraco.SimpleTreeMenu</RepositoryUrl>
		<Description>Typed Treemenu for Umbraco</Description>
		<PackageTags>umbraco,menu,treemenu,umbraco-marketplace</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Version)' &lt; '5.0.0'">
		<IncludeContentInPack>true</IncludeContentInPack>
		<ContentTargetFolders>content</ContentTargetFolders>
		<DefineConstants>ISNOTBELLISSIMA</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Version)' &gt;= '5.0.0'">
		<StaticWebAssetBasePath>/</StaticWebAssetBasePath>
		<ContentTargetFolders>.</ContentTargetFolders>
		<DefineConstants>ISBELLISSIMA</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<PackageReference Include="UmbracoCms.Core" Version="8.7.1" />
		<PackageReference Include="UmbracoCms.Web" Version="8.7.1" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net5.0'">
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="9.0.0" />
		<PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="10.0.0" />
		<PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="11.0.0" />
		<PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="[13.0.0,14.0.0)" />
		<PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="[13.0.0,14.0.0)" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="[16.0.0,17.0.0)" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="[17.0.0,18.0.0)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>

		<None Include="icon.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup Condition="'$(Version)' &lt; '5.0.0'">
		<Content Remove="wwwroot\App_Plugins\**\*.*" />
		<None Remove="wwwroot\App_Plugins\**\*.*" />
		<Content Include="App_Plugins\**\*.*">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</Content>
		<Compile Remove="**\*" />
		<None Include="build\**\*.*">
			<Pack>True</Pack>
			<PackagePath>buildTransitive</PackagePath>
		</None>
	</ItemGroup>
	
	<ItemGroup Condition="'$(Version)' &gt;= '5.0.0'">
		<Content Remove="App_Plugins\**\*.*" />
		<None Remove="App_Plugins\**\*.*" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="SimpleTreeMenuPropertyEditor.cs" />
		<Compile Include="ValueConverters\ISimpleTreeItem.cs" />
		<Compile Include="ValueConverters\ISimpleTreeMenu.cs" />
		<Compile Include="ValueConverters\SimpleTreeItem.cs" />
		<Compile Include="ValueConverters\SimpleTreeMenu.cs" />
		<Compile Include="ValueConverters\SimpleTreeMenuConverter.cs" />
	</ItemGroup>

	<Target Name="RemoveLoggingAnalyzer" BeforeTargets="CoreCompile">
		<ItemGroup>
			<Analyzer Remove="@(Analyzer)" Condition="%(FileName) == 'Lucene.Net.CodeAnalysis.CSharp'" />
		</ItemGroup>
	</Target>

	<!-- Build the Lit client (v5+) so wwwroot\App_Plugins\SimpleTreeMenu is up to date before packing. -->
	<PropertyGroup Condition="'$(Version)' &gt;= '5.0.0'">
		<LitClientFolder>$(MSBuildProjectDirectory)\..\Our.Umbraco.SimpleTreeMenu.LitClient</LitClientFolder>
	</PropertyGroup>

	<!-- Run only during dotnet pack, once for the whole multi-targeted build (not per-TFM), to avoid parallel npm collisions. -->
	<Target Name="BuildLitClient" BeforeTargets="GenerateNuspec" Condition="'$(Version)' &gt;= '5.0.0' and '$(SkipLitClientBuild)' != 'true' and ('$(IsCrossTargetingBuild)' == 'true' or '$(TargetFrameworks)' == '')">
		<Message Text="Building SimpleTreeMenu Lit client in $(LitClientFolder)" Importance="high" />
		<!-- Restore deps only when node_modules is missing: npm ci wipes node_modules and is prone to transient EPERM file locks, so skip it on repeat/local builds. -->
		<Exec Command="npm ci" WorkingDirectory="$(LitClientFolder)" Condition="!Exists('$(LitClientFolder)\node_modules')" />
		<Exec Command="npm run build" WorkingDirectory="$(LitClientFolder)" />
	</Target>
</Project>
